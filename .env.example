# Template for .env — this file IS committed, so it must never contain
# real passwords. Copy it to .env and fill in your own values.
DATABASE_URL=postgresql+psycopg://YOUR_USERNAME@localhost:5432/stockex
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
